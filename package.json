{
  "name": "di-chua-online-tiktok-live",
  "version": "1.0.0",
  "description": "Đi Chùa Online - Chốn Bình An: Interactive TikTok LIVE Stream App (9:16) powered by TikTok-Live-Connector",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup:connector": "npm --prefix ./TikTok-Live-Connector install && npm --prefix ./TikTok-Live-Connector run build"
  },
  "dependencies": {
    "tiktok-live-connector": "file:./TikTok-Live-Connector"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
